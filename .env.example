# Copy to .env.web.local. Keep the actual gateway key out of Git.
AGENT_KIT_API_KEY=
AGENT_KIT_MODEL_BASE_URL=http://127.0.0.1:8080/v1
AGENT_KIT_MODEL=gpt-6.1-sol
AGENT_KIT_WEB_PORT=8787
AGENT_KIT_WEB_UI=chat
# Optional: named environments, resolved relative to the launch directory.
# AGENT_KIT_ENV_CONFIG=./examples/agent-kit.config.json
