{
  "name": "agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Pi tools with Effect and a Wire-assembled Go SDK for local and WebSocket remote execution",
  "type": "module",
  "bin": {
    "agent-kit": "./dist/main.js"
  },
  "files": [
    "dist",
    "binaries",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chovy-ai/agent-kit.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./go-bridge": {
      "types": "./dist/modules/go-bridge/index.d.ts",
      "import": "./dist/modules/go-bridge/index.js"
    },
    "./environment": {
      "types": "./dist/modules/environment/index.d.ts",
      "import": "./dist/modules/environment/index.js"
    },
    "./filesystem": {
      "types": "./dist/modules/filesystem/index.d.ts",
      "import": "./dist/modules/filesystem/index.js"
    },
    "./process": {
      "types": "./dist/modules/process/index.d.ts",
      "import": "./dist/modules/process/index.js"
    },
    "./agent": {
      "types": "./dist/modules/agent/index.d.ts",
      "import": "./dist/modules/agent/index.js"
    },
    "./pi-extension": {
      "types": "./dist/integrations/pi-extension.d.ts",
      "import": "./dist/integrations/pi-extension.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ts": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:go": "node scripts/build-go.mjs",
    "prepack": "npm run build:ts && node scripts/build-go.mjs --bundle",
    "pack:local": "node scripts/pack.mjs",
    "pack:release": "node scripts/pack.mjs --all",
    "verify:package": "node scripts/verify-package.mjs",
    "build": "npm run build:ts && npm run build:go",
    "generate:wire": "cd go && go tool wire ./internal/di",
    "generate:protocol": "sh scripts/generate-protocol.sh",
    "test": "npm run build:go && tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "start": "npm run build && node dist/main.js",
    "check": "sh scripts/check.sh",
    "start:web": "npm run build && npm run build:web && node scripts/start-web.mjs",
    "test:web": "npm run build && npm run typecheck:web && tsx --test test/pi-extension.test.ts test/chat-state.test.ts && node --test test/web-config.test.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "effect": "4.0.3",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@nextop-os/ui-system": "0.0.32",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pi-web-ui": "0.104.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "pi": {
    "extensions": [
      "./dist/integrations/pi-extension.js"
    ]
  }
}
